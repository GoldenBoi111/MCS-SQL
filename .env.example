# MCS-SQL Configuration
# Copy this file to .env and update paths for your environment

# =============================================================================
# Base Paths
# =============================================================================

# Root directory of the MCS-SQL project
PROJECT_ROOT=/path/to/MCS-SQL

# =============================================================================
# Dataset Paths
# =============================================================================

# Training dataset
TRAIN_DATASET=${PROJECT_ROOT}/train/train/train.json

# Development databases
DEV_DATABASES=${PROJECT_ROOT}/minidev

# =============================================================================
# FAISS Index Paths
# =============================================================================

# FAISS index for standard (unmasked) questions
FAISS_INDEX=${PROJECT_ROOT}/faiss-index

# FAISS index for masked questions
FAISS_INDEX_MASKED=${PROJECT_ROOT}/faiss-index-masked

# =============================================================================
# Model Configuration
# =============================================================================

# Embedding model name (for sentence-transformers)
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# LLM model name (for SQL generation)
# Options:
#   - openai/gpt-oss-120b      (120B parameters, use vLLM tensor parallelism across 4 GPUs)
#   - Qwen/Qwen2.5-7B-Instruct  (fast, ~14GB VRAM per copy, 2 copies/GPU)
#   - Qwen/Qwen2.5-14B-Instruct (balanced, ~28GB VRAM per copy, 1 copy/GPU)
#   - Qwen/Qwen2.5-Coder-32B-Instruct (best quality smaller-model option)
#
# For 4xA100 setup with gpt-oss-120b:
#   - 1 model distributed across 4 GPUs
#   - ~70-75 GB VRAM per GPU
#   - Use vLLM for best throughput
LLM_MODEL_NAME=openai/gpt-oss-120b

# =============================================================================
# Multi-GPU Configuration
# =============================================================================

# Number of GPUs to use for multi-GPU benchmark
NUM_GPUS=4

# Model copies per GPU (auto-detected based on model size)
# For gpt-oss-120b: use vLLM tensor parallelism instead of multiple copies
# For 7B model on 80GB A100: 2 copies per GPU (~14 GB each)
# For 14B model on 80GB A100: 1 copy per GPU (~28 GB each)
MODEL_COPIES_PER_GPU=1

# Batch size for parallel generation
# For gpt-oss-120b: keep this conservative and rely on tensor parallelism
# For 7B model: 8
# For larger models: reduce to 4 if OOM
BATCH_SIZE=8

# =============================================================================
# vLLM Configuration (for 120B+ models)
# =============================================================================

# Enable vLLM backend (set to true for 120B models)
VLLM_ENABLED=true

# vLLM tensor parallel size (number of GPUs to use for single model)
# For 120B on 4xA100: set to 4
VLLM_TENSOR_PARALLEL_SIZE=4

# vLLM GPU memory utilization (0.90-0.95 recommended)
VLLM_GPU_MEMORY_UTILIZATION=0.95

# vLLM maximum model length (prompt + output tokens)
VLLM_MAX_MODEL_LEN=8192

# vLLM API server URL (if running server separately)
VLLM_API_URL=http://localhost:8000

# vLLM maximum tokens to generate
VLLM_MAX_TOKENS=2048

# vLLM temperature for sampling
VLLM_TEMPERATURE=0.3

# =============================================================================
# LLM Generation Parameters
# =============================================================================

# Maximum new tokens for LLM generation
# 512 is usually enough for most SQL queries
LLM_MAX_NEW_TOKENS=512

# Temperature for LLM sampling
LLM_TEMPERATURE=0.3

# =============================================================================
# Prompts Path
# =============================================================================

# Directory containing prompt templates
PROMPTS_DIR=${PROJECT_ROOT}/prompts

# =============================================================================
# Processing Configuration
# =============================================================================

# Batch size for embedding generation
EMBEDDING_BATCH_SIZE=1000

# Batch size for FAISS indexing
INDEX_BATCH_SIZE=10000

# Maximum entries to process (for testing, set to empty for unlimited)
MAX_ENTRIES=

# =============================================================================
# LLM Configuration
# =============================================================================

# Device for LLM inference (cuda or cpu)
LLM_DEVICE=cuda

# Maximum new tokens for LLM generation
LLM_MAX_NEW_TOKENS=512

# Temperature for LLM sampling (0.0 for deterministic)
LLM_TEMPERATURE=0.7

# Number of shuffle iterations for table linking
TABLE_LINKING_ITERATIONS=3

# Number of shuffle iterations for column linking
COLUMN_LINKING_ITERATIONS=3

# Number of parallel outputs for majority voting
MAJORITY_VOTE_N=20

# =============================================================================
# FAISS Configuration
# =============================================================================

# FAISS index type (Flat, IVF, HNSW)
FAISS_INDEX_TYPE=HNSW

# =============================================================================
# Database Configuration
# =============================================================================

# Default database for schema linking (relative to DEV_DATABASES)
DEFAULT_DATABASE=california_schools/california_schools.sqlite
